{
  "name": "soundwave-player",
  "version": "3.0.0",
  "private": true,
  "description": "SoundWave mobile music player",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "android:add": "npm run build:web && npx cap add android && npm run android:patch",
    "android:patch": "node scripts/patch-android.mjs",
    "android:sync": "npm run build:web && npx cap sync android && npm run android:patch",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/local-notifications": "^6.1.0",
    "@jofr/capacitor-media-session": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0"
  }
}
